# ── HubSpot Developer Credentials ────────────────────────────────────────────
HUBSPOT_CLIENT_ID=your-client-id
HUBSPOT_CLIENT_SECRET=your-client-secret
HUBSPOT_APP_ID=your-numeric-app-id
HUBSPOT_DEVELOPER_API_KEY=your-developer-api-key

# ── App URLs ──────────────────────────────────────────────────────────────────
BASE_URL=https://your-app.onrender.com
HUBSPOT_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# ── PayPal ────────────────────────────────────────────────────────────────────
# Credentials from developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox                  # change to "live" for production
PAYPAL_WEBHOOK_ID=your-webhook-id   # from PayPal developer portal after adding a webhook

# Plan IDs — created by running: npm run setup-paypal
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_ENTERPRISE_MONTHLY=
PAYPAL_PLAN_ENTERPRISE_YEARLY=

# ── Pricing (USD, change to suit) ─────────────────────────────────────────────
PRICE_PRO_MONTHLY=49
PRICE_PRO_YEARLY=490        # ~$40.83/month, save ~17%
PRICE_ENTERPRISE_MONTHLY=149
PRICE_ENTERPRISE_YEARLY=1490  # ~$124.17/month, save ~17%

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protect the /admin dashboard with a secret token
ADMIN_SECRET=change-me-to-something-strong

# ── Database (Turso) ──────────────────────────────────────────────────────────
# Production: get from turso.tech after running: turso db create sequence-automation
# Leave blank for local development (uses ./data/tokens.db automatically)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
