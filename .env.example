# ── HubSpot Developer Credentials ────────────────────────────────────────────
# Found at: app.hubspot.com → Developer account → Apps → Your app → Auth
HUBSPOT_CLIENT_ID=your-client-id
HUBSPOT_CLIENT_SECRET=your-client-secret
HUBSPOT_APP_ID=your-numeric-app-id

# Developer API key – found at: app.hubspot.com → Developer account → Apps → Get HubSpot API key
HUBSPOT_DEVELOPER_API_KEY=your-developer-api-key

# ── App URLs ──────────────────────────────────────────────────────────────────
# Public URL of this server (no trailing slash).
# For local dev with ngrok: https://xxxx.ngrok-free.app
# For Fly.io: https://sequence-automation.fly.dev
BASE_URL=https://your-app.fly.dev

# Must match exactly what's registered under "Auth → Redirect URL" in your HubSpot app
HUBSPOT_REDIRECT_URI=https://your-app.fly.dev/auth/callback

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
