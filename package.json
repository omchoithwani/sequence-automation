{
  "name": "sequence-automation",
  "version": "1.0.0",
  "description": "HubSpot public app: enroll contacts in sequences and random-branch via workflow actions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "register-actions": "ts-node --transpile-only scripts/register-actions.ts",
    "setup-paypal": "ts-node --transpile-only scripts/setup-paypal.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
